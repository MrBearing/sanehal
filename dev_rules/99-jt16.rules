# Stable JT16 serial device names used by sanehal_bringup/config/jt16_serial.yaml.
# Prolific ATEN USB-RS485 adapter: point cloud stream.
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23a3", ATTRS{serial}=="DDDOb114J19", GROUP="dialout", MODE="0660", TAG+="uaccess", SYMLINK+="jt16_rs485"

# FTDI FT232R USB-RS232 adapter: commands and angle calibration.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="A50285BI", GROUP="dialout", MODE="0660", TAG+="uaccess", ATTR{device/latency_timer}="1", SYMLINK+="jt16_rs232"
