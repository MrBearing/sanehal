<?xml version="1.0"?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffdrive_robot">
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find sanehal_vehicle_description)/urdf/sanehal.xacro" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find sanehal_vehicle_description)/gazebo/sanehal.materials.xacro" />

  <!-- Import sanehal ros2_control description -->
  <xacro:include filename="$(find sanehal_vehicle_description)/ros2_control/sanehal.ros2_control.xacro" />

  <link name="$(arg prefix)base_link" />
  <xacro:sanehal
      prefix="$(arg prefix)"
      parent="$(arg prefix)base_link">
    <origin
        xyz="0 0 0"
        rpy="0 0 0" />
  </xacro:sanehal>
  <xacro:sanehal_ros2_control
    name="Sanehal" prefix="$(arg prefix)" />

</robot>
